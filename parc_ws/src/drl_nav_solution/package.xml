<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drl_nav_solution</name>
  <version>0.1.0</version>
  <description>ARCX6 PARC 2026 map-free solution whose driving legs use a PEEMEF-DARC deep-reinforcement-learning policy (He et al., Sensors 2024) instead of Nav2; reuses explore_solution / task_solution for tag discovery, alignment and the referee.</description>
  <maintainer email="eyiramgaze@gmail.com">ARCX6</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>explore_solution</exec_depend>
  <exec_depend>task_solution</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
