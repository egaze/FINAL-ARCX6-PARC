<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arcx6_monitor</name>
  <version>0.0.1</version>
  <description>ARCX6 PARC 2026: read-only run monitor. Logs which tags the cameras see, what the solution knows/targets/reported, referee state and robot motion. Publishes nothing.</description>
  <maintainer email="eyiramgaze@gmail.com">ARCX6</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
  <exec_depend>parc_msgs</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
